# goals.config - Tieu chi dat/khong dat bai DNS Tunneling / Data Exfiltration

dns_c2_blocked     = boolean : _dns_blocked
malware_eliminated = boolean : ( _exfil_stopped and _persist_removed )
data_protected     = boolean : _vault_secured
tunnel_detected    = boolean : _dns_logged

# MUC TIEU TONG: Da chan DNS C2 + Diet ma doc exfil + Bao ve file du lieu nhay cam
incident_resolved  = boolean : ( dns_c2_blocked and malware_eliminated and data_protected and _marker )
