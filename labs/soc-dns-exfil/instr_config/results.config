# results.config - Trich du lieu cham diem bai DNS Tunneling / Data Exfiltration (doc tu prestop.stdout)

_marker            = target:prestop.stdout : FILE_REGEX : PRESTOP_MARKER

# 1. Da chan Server DNS ma (172.20.0.5) tren iptables?
_dns_blocked       = target:prestop.stdout : FILE_REGEX : 172\.20\.0\.5(/32)?.*(DROP|REJECT)

# 2. Tien trinh va cronjob ma doc exfil da bi diet / xoa bo?
_exfil_stopped     = target:prestop.stdout : FILE_REGEX : EXFIL_PROC_STOPPED
_persist_removed   = target:prestop.stdout : FILE_REGEX : EXFIL_PERSISTENCE_REMOVED

# 3. File du lieu nhay cam (/opt/company/secret_vault.txt) da duoc khoa quyen hoac ma hoa?
_vault_secured     = target:prestop.stdout : FILE_REGEX : VAULT_PERM:(600|400|000)

# 4. Log DNS Tunneling co ghi nhan truy van subdomain Base64?
_dns_logged        = target:prestop.stdout : FILE_REGEX : attacker\.com

# --- Goi y checkwork ---
#CHECK_TRUE: Chua chan Server DNS ma (172.20.0.5) tren iptables (VD: sudo iptables -A OUTPUT -d 172.20.0.5 -j DROP).
cw_dns_blocked = target:prestop.stdout : FILE_REGEX : 172\.20\.0\.5(/32)?.*(DROP|REJECT)
#CHECK_TRUE: Tien trinh ma doc (.dns_exfil.sh) van dang chay ngam - hay kill tien trinh va xoa cron /etc/cron.d/dns-sync.
cw_exfil_stopped = target:prestop.stdout : FILE_REGEX : EXFIL_PROC_STOPPED
#CHECK_TRUE: Van con file script /usr/local/bin/.dns_exfil.sh hoac cron /etc/cron.d/dns-sync.
cw_persist_removed = target:prestop.stdout : FILE_REGEX : EXFIL_PERSISTENCE_REMOVED
#CHECK_TRUE: Chua khoa quyen file nhay cam /opt/company/secret_vault.txt (VD: sudo chmod 600 /opt/company/secret_vault.txt).
cw_vault_secured = target:prestop.stdout : FILE_REGEX : VAULT_PERM:(600|400|000)
