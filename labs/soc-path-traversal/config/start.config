# start.config - Lab soc-path-traversal (KB4 - Quet thu muc & Path Traversal + Snort IDS)
# 4 container: attacker (hidden), target (nan nhan: Web + Snort + Wazuh Agent), siem (Wazuh), defender (analyst)

GLOBAL_SETTINGS
	LAB_MASTER_SEED soc-path-traversal_student_master_seed
	GRADE_CONTAINER target

# Mang ao SOC cho tat ca cac may
NETWORK  SOC_NET
	MASK 172.20.0.0/24
	GATEWAY 172.20.0.101

# --- May nan nhan (chay Web Apache/PHP + Snort IDS + wazuh-agent) ---
CONTAINER target
	USER ubuntu
	SOC_NET 172.20.0.10
	ADD-HOST attacker:172.20.0.5
	ADD-HOST siem:172.20.0.20
	TERMINALS 1

# --- Ke tan cong tu dong (an, dirb / curl quet thu muc & khai thac Path Traversal) ---
CONTAINER attacker
	USER ubuntu
	SOC_NET 172.20.0.5
	ADD-HOST target:172.20.0.10
	TERMINALS 0

# --- SIEM: Wazuh All-in-One ---
CONTAINER siem
	USER ubuntu
	SOC_NET 172.20.0.20
	ADD-HOST target:172.20.0.10
	ADD-HOST attacker:172.20.0.5
	TERMINALS 1

# --- DEFENDER: Tram Analyst (Firefox GUI + SSH) ---
CONTAINER defender
	USER ubuntu
	SOC_NET 172.20.0.30
	ADD-HOST siem:172.20.0.20
	ADD-HOST target:172.20.0.10
	ADD-HOST attacker:172.20.0.5
	X11 YES
	TERMINALS 1
