# results.config - Trich du lieu cham diem bai Path Traversal & Snort IDS (doc tu prestop.stdout)

_marker          = target:prestop.stdout : FILE_REGEX : PRESTOP_MARKER

# 1. Phan quyen thu muc nhay cam da duoc siet chat? (PERM:700/750/000 hoac HTTP 403 Forbidden)
_perm_fixed      = target:prestop.stdout : FILE_REGEX : (PERM:(700|750|500|600|000)|OWNER:root:root|SECRET_HTTP_CODE:403)

# 2. Da viet rule Snort IDS phat hien Path Traversal (../ hoac etc/passwd)?
_snort_rule      = target:prestop.stdout : FILE_REGEX : alert[[:space:]]+(tcp|ip).*content:.*(\.\./|etc/passwd)

# 3. Dich vu Web chinh van song binh thuong (200 OK)?
_web_alive       = target:prestop.stdout : FILE_REGEX : WEB_SERVICE_ALIVE_OK

# 4. Ghi nhan tan cong Path Traversal & 404 Scanning trong log?
_scan_detected   = target:prestop.stdout : FILE_REGEX : etc/passwd

# --- Goi y checkwork ---
#CHECK_TRUE: Chua phan quyen lai thu muc nhay cam /var/www/html/secret_<SECID> (VD: sudo chown -R root:root ... && sudo chmod 700 ...).
cw_perm_fixed = target:prestop.stdout : FILE_REGEX : (PERM:(700|750|500|600|000)|SECRET_HTTP_CODE:403)
#CHECK_TRUE: Chua them rule Snort IDS canh bao Path Traversal vao /etc/snort/rules/local.rules (content:"../" hoac content:"etc/passwd").
cw_snort_rule = target:prestop.stdout : FILE_REGEX : alert[[:space:]]+(tcp|ip).*content:.*(\.\./|etc/passwd)
#CHECK_TRUE: Trang chu Web chinh (/index.html) khong phan hoi 200 OK (co the ban da xoa nham hoac tat Apache).
cw_web_alive = target:prestop.stdout : FILE_REGEX : WEB_SERVICE_ALIVE_OK
