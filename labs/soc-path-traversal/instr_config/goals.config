# goals.config - Tieu chi dat/khong dat bai Quet thu muc & Path Traversal (Snort IDS)

permissions_secured = boolean : _perm_fixed
snort_rule_added    = boolean : _snort_rule
service_available   = boolean : _web_alive
attack_logged       = boolean : _scan_detected

# MUC TIEU TONG: Da siet quyen thu muc nhay cam + Da viet rule Snort IDS + Dich vu Web van hoat dong
incident_resolved   = boolean : ( permissions_secured and snort_rule_added and service_available and _marker )
