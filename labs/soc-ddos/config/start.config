# start.config - Lab soc-ddos (KB2 - SYN Flood / DDoS Rate Limiting)
# 4 container: attacker (hidden), target (nạn nhân), siem (Wazuh), defender (analyst)

GLOBAL_SETTINGS
	LAB_MASTER_SEED soc-ddos_student_master_seed
	GRADE_CONTAINER target

# Mạng ảo SOC cho tất cả các máy
NETWORK  SOC_NET
	MASK 172.20.0.0/24
	GATEWAY 172.20.0.101

# --- Máy nạn nhân (chạy dịch vụ Web HTTP/80 + wazuh-agent) ---
CONTAINER target
	USER ubuntu
	SOC_NET 172.20.0.10
	ADD-HOST attacker:172.20.0.5
	ADD-HOST siem:172.20.0.20
	TERMINALS 1

# --- Kẻ tấn công tự động (ẩn, hping3 SYN flood) ---
CONTAINER attacker
	USER ubuntu
	SOC_NET 172.20.0.5
	ADD-HOST target:172.20.0.10
	TERMINALS 0

# --- SIEM: Wazuh All-in-One ---
CONTAINER siem
	USER ubuntu
	SOC_NET 172.20.0.20
	ADD-HOST target:172.20.0.10
	ADD-HOST attacker:172.20.0.5
	TERMINALS 1

# --- DEFENDER: Trạm Analyst (Firefox GUI + SSH) ---
CONTAINER defender
	USER ubuntu
	SOC_NET 172.20.0.30
	ADD-HOST siem:172.20.0.20
	ADD-HOST target:172.20.0.10
	ADD-HOST attacker:172.20.0.5
	X11 YES
	TERMINALS 1
