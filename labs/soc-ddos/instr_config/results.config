# results.config - Trich du lieu cham diem (doc tu prestop.stdout)

_marker       = target:prestop.stdout : FILE_REGEX : PRESTOP_MARKER
# Da ap dung giai phap ngan chan SYN Flood? (Rate-limiting / Syncookies / Drop IP)
_rate_limit   = target:prestop.stdout : FILE_REGEX : -m (limit|hashlimit)
_syncookies   = target:prestop.stdout : FILE_REGEX : net\.ipv4\.tcp_syncookies = 1
_blocked      = target:prestop.stdout : FILE_REGEX : 172\.20\.0\.5.*(DROP|REJECT)

# Dich vu Web tren Target van hoat dong phan hoi (khong bi chet / khong bi chan nham)?
_web_alive    = target:prestop.stdout : FILE_REGEX : WEB_SERVICE_ALIVE_OK

# SIEM co ghi nhan tan cong từ attacker 172.20.0.5?
_siem_detected = siem:prestop.stdout : FILE_REGEX : 172\.20\.0\.5

# --- Goi y checkwork ---
#CHECK_TRUE: Chua ap dung giai phap Rate Limiting (iptables -m limit) hoac Bat TCP Syncookies (sysctl -w net.ipv4.tcp_syncookies=1).
cw_mitigation = target:prestop.stdout : FILE_REGEX : -m (limit|hashlimit)|net\.ipv4\.tcp_syncookies = 1|172\.20\.0\.5.*(DROP|REJECT)
#CHECK_TRUE: Dich vu Web tren Target khong phan hoi (bi treo hoac bi iptables chan nham ca localhost).
cw_web_alive = target:prestop.stdout : FILE_REGEX : WEB_SERVICE_ALIVE_OK
