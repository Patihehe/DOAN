# goals.config - Tieu chi dat/khong dat bai SYN Flood Rate Limiting

mitigation_applied = boolean : ( _rate_limit or _syncookies or _blocked )
service_available  = boolean : _web_alive
siem_detected      = boolean : _siem_detected

# MUC TIEU TONG: Da ngan chan thanh cong SYN flood + Dich vu Web van phan hoi binh thuong
incident_resolved  = boolean : ( mitigation_applied and service_available and _marker )
