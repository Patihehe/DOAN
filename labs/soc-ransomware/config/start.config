# start.config - Lab soc-ransomware (Phan ung nhanh voi Ransomware & Khoi phuc du lieu)
# 4 container: attacker (C2 Trigger - hidden), target (File Server bi Ransomware), siem (Wazuh Shared), defender (Analyst)

GLOBAL_SETTINGS
	LAB_MASTER_SEED soc-ransomware_student_master_seed
	GRADE_CONTAINER target

# Mang ao SOC cho tat ca cac may
NETWORK  SOC_NET
	MASK 172.20.0.0/24
	GATEWAY 172.20.0.101

# --- May nan nhan (File Server /srv/shares/finance + Wazuh FIM + tien trinh Ransomware) ---
CONTAINER target
	USER ubuntu
	SOC_NET 172.20.0.10
	ADD-HOST attacker:172.20.0.5
	ADD-HOST siem:172.20.0.20
	TERMINALS 1

# --- Ke tan cong / Ransomware C2 Server (an, nhan bao cao trang thai ma hoa tu target) ---
CONTAINER attacker
	USER ubuntu
	SOC_NET 172.20.0.5
	ADD-HOST target:172.20.0.10
	TERMINALS 0

# --- SIEM: Wazuh All-in-One (Dung chung image soc-wazuh tiet kiem dung luong) ---
CONTAINER siem
	USER ubuntu
	SOC_NET 172.20.0.20
	ADD-HOST target:172.20.0.10
	ADD-HOST attacker:172.20.0.5
	TERMINALS 1

# --- DEFENDER: Tram Analyst (Firefox GUI + SSH) ---
CONTAINER defender
	USER ubuntu
	SOC_NET 172.20.0.30
	ADD-HOST siem:172.20.0.20
	ADD-HOST target:172.20.0.10
	ADD-HOST attacker:172.20.0.5
	X11 YES
	TERMINALS 1
