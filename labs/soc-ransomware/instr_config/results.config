# results.config - Trich du lieu cham diem bai Ransomware Incident Response (doc tu prestop.stdout)

_marker            = target:prestop.stdout : FILE_REGEX : PRESTOP_MARKER

# 1. Da tieu diet tien trinh Ransomware (.kworker_crypt) va xoa persistence (/etc/cron.d/sys-crypt)?
_proc_killed       = target:prestop.stdout : FILE_REGEX : RANSOM_PROC_KILLED
_persist_removed   = target:prestop.stdout : FILE_REGEX : RANSOM_PERSIST_REMOVED

# 2. Da trich xuat khoa va giai ma khoi phuc thanh cong 3 file tai chinh goc?
_files_decrypted   = target:prestop.stdout : FILE_REGEX : FILES_DECRYPTED_OK

# 3. Da xoa sach cac file .enc va to doi tien chuoc README_DECRYPT.txt?
_cleanup_done      = target:prestop.stdout : FILE_REGEX : CLEANUP_COMPLETE_OK

# 4. Log ghi nhan hoat dong ma hoa cua Ransomware?
_ransom_logged     = target:prestop.stdout : FILE_REGEX : Encrypted file

# --- Goi y checkwork ---
#CHECK_TRUE: Tien trinh Ransomware (.kworker_crypt) van dang chay - hay trich xuat RANSOM_KEY tu /proc/<PID>/environ roi kill -9.
cw_proc_killed = target:prestop.stdout : FILE_REGEX : RANSOM_PROC_KILLED
#CHECK_TRUE: Van con file /var/tmp/.kworker_crypt hoac cron /etc/cron.d/sys-crypt.
cw_persist_removed = target:prestop.stdout : FILE_REGEX : RANSOM_PERSIST_REMOVED
#CHECK_TRUE: Cac file goc (payroll_2026.csv, budget_q4.txt, merger_plan.txt) chua duoc giai ma phuc hoi dung noi dung.
cw_files_decrypted = target:prestop.stdout : FILE_REGEX : FILES_DECRYPTED_OK
#CHECK_TRUE: Van con file *.enc hoac to doi tien chuoc README_DECRYPT.txt trong /srv/shares/finance/.
cw_cleanup_done = target:prestop.stdout : FILE_REGEX : CLEANUP_COMPLETE_OK
