# goals.config - Tieu chi dat/khong dat bai Phan ung nhanh voi Ransomware & Khoi phuc du lieu

ransomware_stopped = boolean : ( _proc_killed and _persist_removed )
data_recovered     = boolean : _files_decrypted
ransom_cleaned     = boolean : _cleanup_done
fim_alert_logged   = boolean : _ransom_logged

# MUC TIEU TONG: Da diet Ransomware + Giai ma khoi phuc 100% du lieu + Don sach file .enc & ransom note
incident_resolved  = boolean : ( ransomware_stopped and data_recovered and ransom_cleaned and _marker )
